<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Expose the thermal ticket setting on each company -->
    <record id="view_company_form_thermal_ticket" model="ir.ui.view">
        <field name="name">res.company.form.thermal.ticket</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="inside">
                <group string="Ticket Térmico">
                    <field name="thermal_ticket_show_company"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
